# StudentMart Server Configuration

# Application Port
PORT=5002

# JWT Secret Key for token authentication
JWT_SECRET=studentmart_jwt_secret_key_2026

# --- MongoDB Connection Options ---

# Option A: Local MongoDB (Default Windows Service)
MONGO_URI=mongodb://127.0.0.1:27017/studentmart

# Option B: MongoDB Atlas (Free Cloud Database)
# Replace <username>, <password>, and <cluster-url> with your MongoDB Atlas details:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>.mongodb.net/studentmart?retryWrites=true&w=majority
